! ==========================================================
! CISCO PACKET TRACER AUTOMATION SCRIPT
! Target Device: Switch1
! Scenario: IP_ADDRESSING_Switch1
! Instructions: Open Packet Tracer -> Click Device -> CLI -> Paste
! ==========================================================
enable
configure terminal
hostname Switch1
interface GigabitEthernet0/1
 ip address 192.168.1.1 255.255.255.0
 no shutdown
exit
end
write memory
end
write memory
show running-config
