! ==========================================================
! CISCO PACKET TRACER AUTOMATION SCRIPT
! Target Device: SW_18
! Scenario: VLAN_TRUNK_SW_18
! Instructions: Open Packet Tracer -> Click Device -> CLI -> Paste
! ==========================================================
enable
configure terminal
hostname SW_18
interface GigabitEthernet0/2
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30
 no shutdown
exit
end
write memory
end
write memory
show running-config
