! ==========================================================
! CISCO PACKET TRACER AUTOMATION SCRIPT
! Target Device: Switch1
! Scenario: ROUTING_OSPF_Switch1
! Instructions: Open Packet Tracer -> Click Device -> CLI -> Paste
! ==========================================================
enable
configure terminal
hostname Switch1
router ospf 1
 network 192.168.10.0 0.0.0.255 area 0
exit
end
write memory
end
write memory
show running-config
