! ==========================================================
! CISCO PACKET TRACER AUTOMATION SCRIPT
! Target Device: Switch1
! Scenario: VLAN_TRUNK_Switch1
! Instructions: Open Packet Tracer -> Click Device -> CLI -> Paste
! ==========================================================
enable
configure terminal
hostname Switch1
interface GigabitEthernet0/1
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30
 no shutdown
exit
end
write memory
end
write memory
show running-config
