! ==========================================================
! CISCO PACKET TRACER AUTOMATION SCRIPT
! Target Device: Switch1
! Scenario: DHCP_Switch1
! Instructions: Open Packet Tracer -> Click Device -> CLI -> Paste
! ==========================================================
enable
configure terminal
hostname Switch1
ip dhcp excluded-address 192.168.20.1
ip dhcp pool SALES_POOL
 network 192.168.20.0 255.255.255.0
 default-router 192.168.20.1
 dns-server 8.8.8.8
exit
end
write memory
end
write memory
show running-config
